# Copy to error_reporting.env (git-ignored) to build with error reporting on.
# tool/build_apk.sh, build_bundle.sh, build_deb.sh and build_linux_release.sh
# pass it with --dart-define-from-file when the file exists. Without it the
# app never starts the reporting SDK and sends nothing.
#
# NTV_ERROR_DSN: the Sentry-protocol DSN of the GlitchTip project
#   (Project settings -> Client Keys) that should receive the reports.
NTV_ERROR_DSN=
