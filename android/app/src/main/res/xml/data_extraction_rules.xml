<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: Google backup and device-to-device transfer copy
     only the newest Nightingale TV backup (backup-restore D13). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backups/cloud/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backups/cloud/"/>
    </device-transfer>
</data-extraction-rules>
