<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin servers on home networks are usually reached by http:// and an
     IP address the user types in, so plain HTTP is allowed. The app talks to
     no other host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
