<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release builds only (share-accounts D3): invite links
         https://<host>/ntv/i/<CODE> open the app, verified with Android App
         Links. The host comes from the git-ignored sharing.env through
         build.gradle.kts; without it it's sharing.invalid, a name that never
         resolves, so the filter never matches. Debug builds have no filter. -->
    <application>
        <activity android:name=".MainActivity" tools:node="merge">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${shareHost}" android:pathPrefix="/ntv/i/"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
